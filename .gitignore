# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# venv / env
.venv/
venv/
env/

# notebooks / scratch
.ipynb_checkpoints/

# Parity golden baselines under tests/_golden/*.pt are SMALL (~9KB) and intentionally COMMITTED:
# the package ships without the source research repo, so parity must be self-contained.
# Ignore only oversized / scratch parity artifacts.
tests/_golden/*.bin
tests/_golden/scratch/

# OS
.DS_Store

# OMC orchestration state (local only — never published)
.omc/

# OSS hardening scaffolding (audit/plan/refactor/test-strategy/ci skill outputs) — local working
# notes only; some cite the maintainer's host path, so they are never committed to the public repo.
OSS_*.md

# User-provided data + run outputs (never committed). The data/ dir itself is kept (via data/README.md)
# so a fresh clone has the place to drop files in; only your data files are ignored.
data/*
!data/README.md
out/
save/
slurm-logs/

# uv cache / managed python placed inside the repo by the SLURM two-phase setup
.uv-cache/
.uv-python/
