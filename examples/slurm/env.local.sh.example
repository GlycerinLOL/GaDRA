#!/usr/bin/env bash
# Machine-local settings for the GaDRA SLURM jobs — secrets + paths that must NOT be committed.
#
# Usage: copy this to `env.local.sh` (which is gitignored), fill in the values for THIS machine, then
# `source` it in the shell you submit from, BEFORE sbatch:
#
#   cp examples/slurm/env.local.sh.example examples/slurm/env.local.sh
#   $EDITOR examples/slurm/env.local.sh
#   source examples/slurm/env.local.sh
#   sbatch examples/slurm/train.slurm                 # or examples/slurm/inference.slurm
#
# Why a sourced file (not inside the .slurm scripts): sbatch reads SBATCH_ACCOUNT / SBATCH_PARTITION from the
# SUBMITTING shell, and forwards the whole env to the job by default — so sourcing here covers both the
# scheduler knobs and the runtime vars, and the committed .slurm scripts never need editing.

# --- Repo root + uv env (shared filesystem visible from BOTH login and compute nodes) ---
# GADRA_REPO is optional if you submit from the repo root (the scripts fall back to $SLURM_SUBMIT_DIR), but
# setting it explicitly is the robust choice.
export GADRA_REPO="/path/to/shared/GaDRA"
export UV_CACHE_DIR="$GADRA_REPO/.uv-cache"
export UV_PYTHON_INSTALL_DIR="$GADRA_REPO/.uv-python"

# --- SLURM account / partition (read by sbatch itself — MUST be set in this shell, not inside the job) ---
export SBATCH_ACCOUNT="<account>"        # e.g. nano5
export SBATCH_PARTITION="<partition>"

# --- Secrets: GPT judge for the bbcqa / tiebe eval tasks. NEVER commit a real key. ---
export OPENAI_API_KEY="sk-..."

# --- Optional run knobs (uncomment as needed) ---
# Training output dir = save/$DATASET/$DATE/CPT/$EXP_NAME :
# export DATASET="BBC_news"
# export EXP_NAME="GaDRA"
# export MBS=16 GBS=128                  # per-device / global batch size (grad-accum auto-computed)
#
# Inference:
# export CONFIG="examples/config/inference.yaml"                       # run-config (suite by default)
# export ADAPTER="/abs/path/to/save/BBC_news/<DATE>/CPT/GaDRA"         # point the eval at your trained dir
